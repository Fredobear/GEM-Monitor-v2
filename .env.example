# Skopiuj ten plik jako .env, aby uruchamiać narzędzie lokalnie (node src/cli.js run).
# W GitHub Actions te same wartości wpisujesz w Settings → Secrets and variables → Actions.
# Pliku .env nigdy nie wysyłaj na GitHub (jest w .gitignore).

# Dane rynkowe – wymagany co najmniej jeden klucz:
TIINGO_API_KEY=
ALPHAVANTAGE_API_KEY=

# Powiadomienia – Telegram i/lub ntfy:
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NTFY_TOPIC=

# Opcjonalnie: komentarz AI (Claude) z analizą polityczną i geopolityczną:
ANTHROPIC_API_KEY=

# Opcjonalnie: adres panelu, jeśli inny niż domyślny https://<login>.github.io/<repozytorium>/
DASHBOARD_URL=
